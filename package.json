{
  "name": "fragout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack && node scripts/exclude-private-runtime.mjs && node scripts/check-public-build.mjs && node scripts/check-server-artifact.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "start:cloud": "node --experimental-strip-types scripts/start-cloud.mjs",
    "ai:paid": "node scripts/set-paid-ai.mjs",
    "ai:configure-free": "node --experimental-strip-types scripts/configure-free-ai.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "catalog:scrape": "node --experimental-strip-types scripts/scrape-fragrance-catalog.mjs",
    "catalog:admin": "node --experimental-strip-types scripts/catalog-admin.mjs",
    "catalog:photos:parfumo": "node --experimental-strip-types scripts/import-parfumo-photos.mjs",
    "catalog:photos:manufacturer": "node --experimental-strip-types scripts/import-manufacturer-photos.mjs",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@vercel/oidc": "3.8.10",
    "lucide-react": "^0.468.0",
    "next": "^16.2.0",
    "postgres": "4.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "tesseract.js": "7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/blob": "2.9.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@vercel/cli-config": { "zod": "4.6.6" }
  },
  "engines": {
    "node": "24.x"
  }
}
