{
  "name": "fragout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build && node scripts/check-public-build.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "start:cloud": "node --experimental-strip-types scripts/start-cloud.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "catalog:scrape": "node --experimental-strip-types scripts/scrape-fragrance-catalog.mjs",
    "catalog:admin": "node --experimental-strip-types scripts/catalog-admin.mjs",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "next": "^16.2.0",
    "postgres": "4.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
