# Qwen is the free default. No paid API credentials are required.
# Run Ollama separately with: ollama pull qwen3-vl:2b-instruct
# FRAGOUT_OLLAMA_URL=http://127.0.0.1:11434
# FRAGOUT_QWEN_MODEL=qwen3-vl:2b-instruct
# Optional: dedicated private directory on persistent disk, with no unrelated files.
# Never place it under public, generated assets, a shared folder or a linked path.
# FRAGOUT_DB=C:/private-fragout-data/fragout.sqlite
# HTTPS hosting requires an explicit exact public origin (no path).
# FRAGOUT_PUBLIC_ORIGIN=https://fragout.example
# Cookies become Secure automatically on HTTPS. Optional forced Secure mode:
# FRAGOUT_SECURE_COOKIES=true
# Development-only LAN phone access also needs next dev and a private LAN origin:
# FRAGOUT_PUBLIC_ORIGIN=http://192.168.1.8:3000
# FRAGOUT_ALLOW_LAN_HTTP=true
# Optional base64-encoded 32-byte key for connection encryption.
# Otherwise data/credential-key is generated automatically. Preserve it with the DB.
# FRAGOUT_VAULT_KEY=
# Users connect their own OpenAI/Claude keys in Settings; never add them here.
# Optional server-only Fragella developer key for live FragDex overall ratings.
# FRAGOUT_FRAGELLA_API_KEY=
# Disable anonymous framework build telemetry:
NEXT_TELEMETRY_DISABLED=1
