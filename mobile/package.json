{
  "name": "fragout-mobile",
  "version": "0.2.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-speech-recognition": "~58.0.1",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^1.70.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-google-mobile-ads": "17.4.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web --output-dir ../public/mobile",
    "export:native": "expo export --platform android --platform ios --output-dir native-dist",
    "lint": "expo lint"
  },
  "private": true,
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  }
