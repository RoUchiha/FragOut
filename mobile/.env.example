# Public server address only. Never put provider keys in EXPO_PUBLIC variables.
# iPhone/Android phone: use an HTTPS backend you control.
# Android emulator local development: http://10.0.2.2:3000
# EXPO_PUBLIC_API_URL=https://your-fragout-server.example

# Optional public AdMob IDs. Each platform needs its own app and banner IDs.
# FRAGOUT_ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
# FRAGOUT_ADMOB_ANDROID_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# FRAGOUT_ADMOB_IOS_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
# FRAGOUT_ADMOB_IOS_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# FRAGOUT_ADS_TEST_MODE=true
